[
  {
    "name": "compile_markdown",
    "description": "Compile Markdown into a Word (.docx) document. Ensure structures beyond standard Markdown (e.g. captions, TOC, page breaks, abstract, math blocks) follow the contract in get_guide. Uses the provided format file, or defaults to a built-in preset.",
    "read_only": false,
    "input_schema": {
      "properties": {
        "markdown": {
          "title": "Markdown",
          "type": "string"
        },
        "output_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Path"
        },
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "preset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preset"
        },
        "generate_pdf": {
          "default": false,
          "title": "Generate Pdf",
          "type": "boolean"
        },
        "lang": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lang"
        },
        "base_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Template"
        },
        "cover_sections": {
          "default": 0,
          "title": "Cover Sections",
          "type": "integer"
        },
        "keep_pages": {
          "default": 0,
          "title": "Keep Pages",
          "type": "integer"
        },
        "keep_until": {
          "default": "",
          "title": "Keep Until",
          "type": "string"
        }
      },
      "required": [
        "markdown"
      ],
      "type": "object",
      "title": "compile_markdownArguments"
    }
  },
