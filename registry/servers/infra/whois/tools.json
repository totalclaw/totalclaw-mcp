[
  {
    "name": "whois_domain",
    "description": "Looksup whois information about the domain",
    "read_only": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "domain"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "whois_tld",
    "description": "Looksup whois information about the Top Level Domain (TLD)",
    "read_only": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "tld": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tld"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "whois_ip",
    "description": "Looksup whois information about the IP",
    "read_only": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "ip": {
          "type": "string",
          "anyOf": [
            {
              "format": "ipv4"
            },
            {
              "format": "ipv6"
            }
          ]
        }
      },
      "required": [
        "ip"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "whois_as",
    "description": "Looksup whois information about the Autonomous System Number (ASN)",
    "read_only": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "asn": {
          "type": "string",
          "pattern": "^AS\\d+$"
        }
      },
      "required": [
        "asn"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  }
]
