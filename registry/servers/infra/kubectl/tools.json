        },
        "context": {
          "default": "",
          "type": "string",
          "description": "Kubernetes context to use (optional, uses current context if not specified)"
        }
      },
      "required": [
        "release_name",
        "revision"
      ],
      "type": "object",
      "additionalProperties": false
    }
