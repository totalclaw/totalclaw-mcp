[
  {
    "name": "kubectl_get",
    "description": "List or get any Kubernetes resource, including custom resources (kubectl get).",
    "read_only": true,
    "input_schema": {
      "properties": {
        "resource_type": {
          "type": "string",
          "description": "Kind, plural or short name, e.g. pods, deploy, svc, nodes, events, certificates.cert-manager.io"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A single resource name (omit to list)"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Namespace (omit for the context default; ignored for cluster-scoped kinds)"
        },
        "all_namespaces": {
          "default": false,
          "type": "boolean",
          "description": "List across all namespaces"
        },
        "label_selector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. app=web,tier!=db"
        },
        "field_selector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. status.phase=Running or involvedObject.name=web-123"
        },
        "output": {
          "default": "table",
          "type": "string",
          "description": "table (default), wide, name, yaml or json. Secret values are always redacted"
        },
        "sort_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSONPath to sort by, e.g. .lastTimestamp for events"
        },
        "context": {
          "default": "",
          "type": "string",
          "description": "Kubernetes context (optional)"
        }
      },
      "required": [
        "resource_type"
      ],
      "type": "object",
      "additionalProperties": false
    }
  },
  {
    "name": "kubectl_logs",
    "description": "Get container logs (kubectl logs).",
    "read_only": true,
    "input_schema": {
      "properties": {
        "pod_name": {
          "type": "string",
          "description": "Pod name, or TYPE/NAME such as deployment/web to pick a pod of a workload"
        },
        "namespace": {
          "default": "default",
          "type": "string",
          "description": "Namespace of the pod"
        },
        "container": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Container name for multi-container pods"
        },
        "tail": {
          "default": 200,
          "type": "integer",
          "description": "Lines from the end (default 200; -1 for all)"
        },
        "previous": {
          "default": false,
          "type": "boolean",
          "description": "Logs of the previous, crashed container instance"
        },
        "since": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only newer logs, e.g. 10m or 2h"
        },
        "context": {
          "default": "",
          "type": "string",
          "description": "Kubernetes context (optional)"
        }
      },
      "required": [
        "pod_name"
      ],
      "type": "object",
      "additionalProperties": false
    }
  },
