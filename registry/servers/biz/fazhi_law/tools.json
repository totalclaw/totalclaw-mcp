[
  {
    "name": "practice_search",
    "description": "执行互联网搜索，返回与检索query相关的网页内容摘要，当问题涉及具体事件、案例背景或需要外部信息补充时必须优先使用。",
    "read_only": false,
    "input_schema": {
      "required": [
        "query"
      ],
      "type": "object",
      "properties": {
        "query": {
          "description": "搜索关键词，例如：合同纠纷",
          "type": "string"
        },
        "size": {
          "description": "返回数量",
          "type": "integer"
        },
        "fields": {
          "description": "返回字段列表，可选值：message、output、refer，不传时无refer",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "webpage_visit",
    "description": "浏览指定一个或者多个url的网页内容并返回与用户查询目标相关的内容摘要，优先阅读政府权威网站、律师律所高质量公众号文章等高价值资料。",
    "read_only": false,
    "input_schema": {
      "required": [
        "url"
      ],
      "type": "object",
      "properties": {
        "uid": {
          "description": "用户ID",
          "type": "string"
        },
        "url": {
          "description": "目标网页URL",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "legal_article_search",
    "description": "统一法条语义检索、精确法条查询、法规名称检索等多种检索模式，支持自然语言检索、关键词检索和精确法条定位，以及效力时间、地域、法律层级等过滤条件。",
    "read_only": false,
    "input_schema": {
      "properties": {
        "size": {
          "description": "返回结果数量，默认5，最大20",
          "type": "integer"
        },
        "law_name": {
          "description": "法律法规名称，例如：中华人民共和国民法典、中华人民共和国刑法",
          "type": "string"
        },
        "item": {
          "description": "法条编号，例如：第五百六十三条。配合 law_name 使用，用于精确法条检索",
          "type": "string"
        },
        "fields": {
          "description": "返回字段列表，可选值：message、output、refer，不传时无refer",
          "type": "string"
        },
        "query": {
          "description": "检索内容，可以是自然语言问题、关键词、法律名称或法条引用，例如：民法典关于合同解除的规定、刑法 第二百六十四条",
          "type": "string"
        },
        "status": {
          "description": "效力状态，可选值：现行有效、已被修改、失效。不传不做约束",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "law_content_visit",
    "description": "阅读指定的法规全文，并根据指定的目标要求提取总结相关信息。",
    "read_only": false,
    "input_schema": {
      "required": [
        "law_id",
        "goal"
      ],
      "type": "object",
      "properties": {
        "law_id": {
          "description": "法规ID",
          "type": "string"
        },
        "max_length": {
          "description": "大于此字数会总结",
          "type": "integer"
        },
        "goal": {
          "description": "总结目标",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "case_search",
    "description": "统一语义检索、关键词检索、时间地域过滤等多种检索模式，支持用自然语言或关键词检索案例，可根据时间范围、地域范围进行过滤。",
    "read_only": false,
    "input_schema": {
      "required": [
        "query"
      ],
      "type": "object",
      "properties": {
        "size": {
          "description": "搜索数量",
          "type": "integer"
        },
        "time": {
          "description": "搜索时间范围，例如：最近5年",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "area": {
          "description": "搜索地域范围，例如：杭州",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "query": {
          "description": "搜索问句列表，例如：房屋租赁合同到期后房东拒绝退还押金",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "fields": {
          "description": "返回字段，可选值：message、output、refer",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "case_browser",
    "description": "根据指定案号或案例名称精确检索单个案例。",
    "read_only": false,
    "input_schema": {
      "properties": {
        "case_name": {
          "description": "案件名称，例如：张三诉李四合同纠纷案",
          "type": "string"
        },
        "case_number": {
          "description": "案号，例如：(2024)京0101民初1234号",
          "type": "string"
        },
        "fields": {
          "description": "返回字段列表，可选值：message、output、refer，不传时无refer",
          "type": "string"
        }
      },
      "type": "object"
    }
  }
]
