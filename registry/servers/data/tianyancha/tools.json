[
  {
    "name": "search_company",
    "description": "按关键词搜索企业，返回公司名、类型、成立日期、经营状态与统一社会信用代码。 拿到准确公司名后再用其他工具查详情。",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "keyword": {
          "type": "string",
          "description": "企业名称关键词"
        },
        "page_num": {
          "type": "integer",
          "description": "页码，从 1 开始"
        },
        "page_size": {
          "type": "integer",
          "description": "每页条数，默认 20"
        }
      },
      "required": [
        "keyword"
      ]
    }
  },
