[
  {
    "name": "search",
    "description": "Search the web using these engines: Duckduckgo, Bing, Exa (no API key required).",
    "read_only": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "number",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        },
        "engines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "default": [
            "duckduckgo"
          ]
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "fetchLinuxDoArticle",
    "description": "Fetch full article content from a linux.do post URL",
    "read_only": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "fetchCsdnArticle",
    "description": "Fetch full article content from a csdn post URL",
    "read_only": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "fetchGithubReadme",
    "description": "Fetch README content from a GitHub repository URL",
    "read_only": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "fetchWebContent",
    "description": "Fetch content from a public HTTP(S) URL. renderMode defaults to auto: request uses HTTP only, auto uses request with browser fallback, and browser renders directly with Playwright and fails clearly when Playwright is unavailable.",
    "read_only": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "maxChars": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 200000,
          "default": 30000
        },
        "readability": {
          "type": "boolean"
        },
        "includeLinks": {
          "type": "boolean"
        },
        "renderMode": {
          "type": "string",
          "enum": [
            "request",
            "auto",
            "browser"
          ]
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "fetchJuejinArticle",
    "description": "Fetch full article content from a Juejin(掘金) post URL",
    "read_only": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  }
]
