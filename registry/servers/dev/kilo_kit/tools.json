          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Skill name or identifier (e.g. 'brainstorming', 'diagnose', 'playwright', 'productivity/brainstorming')."
        },
        "maxChars": {
          "type": "integer",
          "minimum": 100,
          "maximum": 50000,
          "description": "Maximum SKILL.md characters to return."
