  {
    "name": "kilo_triangulate_research",
    "description": "Execute Triangulated Cognitive Synthesis: Combines Internal SQLite Memory, External GitHub Grounding, 3-Option ToT DAG Trade-Offs, and Low-Confidence Research Escalation. Persists reasoning atomically into SQLite before code modification.",
    "read_only": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "description": "Active Kilo-Kit session ID"
        },
        "taskDescription": {
          "type": "string",
          "minLength": 10,
          "description": "The architectural decision, feature spec, or bug to analyze"
        },
        "internalMemoryLearned": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Key facts, reflections, or past pitfalls retrieved from SQLite"
        },
        "externalGroundingPatterns": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Standard patterns, official docs, or 10k+ stars GitHub implementations"
        },
        "dagOptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Option name (e.g. 'Option A: In-Memory Map', 'Option B: Full LangGraph Port', 'Option C: SQLite Grounded Synthesis')"
              },
              "description": {
                "type": "string",
                "minLength": 5,
                "description": "Detailed architecture and mechanism"
              },
              "pros": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "description": "Advantages and strengths"
              },
              "cons": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "description": "Disadvantages, dependencies, or trade-offs"
              },
              "blastRadius": {
                "type": "string",
                "description": "Impact on existing codebase and state"
              }
            },
            "required": [
              "name",
              "description",
              "pros",
              "cons"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "description": "At least 2 (ideally 3) competing architectural options to compare"
        },
        "chosenOption": {
          "type": "string",
          "minLength": 1,
          "description": "The selected option name with rationale"
        },
        "confidenceScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence score between 0.0 and 1.0 (if < 0.70, triggers research escalation)"
        },
        "requiresResearchEscalation": {
          "type": "boolean",
          "description": "Explicitly request deep subagent research fallback"
        },
        "researchFindings": {
          "type": "string",
          "description": "Synthesized findings from research subagent if research escalation was triggered"
        },
        "adversarialRiskScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Adversarial risk score from red-team grilling"
        },
        "format": {
          "type": "string",
          "enum": [
            "markdown",
            "json"
          ],
          "default": "markdown"
        }
      },
      "required": [
        "sessionId",
        "taskDescription",
        "dagOptions",
        "chosenOption",
        "confidenceScore"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
