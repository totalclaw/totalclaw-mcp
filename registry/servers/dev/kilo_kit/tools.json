  {
    "name": "kilo_think_step",
    "description": "Iterative step-by-step reasoning engine with hypothesis tracking, revision, and solution branching.",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 10,
          "description": "REQUIRED for observability: Describe WHAT you are analyzing, e.g. 'So sánh 3 phương án: LocalStorage vs IndexedDB vs Supabase'. This appears in terminal tool call display so users can monitor agent thinking."
        },
        "thought": {
          "type": "string",
          "minLength": 1,
          "description": "Current reasoning thought"
        },
        "thoughtNumber": {
          "type": "integer",
          "minimum": 1,
          "description": "Current thought step index"
        },
        "totalThoughts": {
          "type": "integer",
          "minimum": 1,
          "description": "Estimated total thought steps"
        },
        "nextThoughtNeeded": {
          "type": "boolean",
          "description": "Whether more reasoning steps are needed"
        },
        "isRevision": {
          "type": "boolean",
          "description": "Whether this thought revises an earlier thought"
        },
        "revisesThought": {
          "type": "integer",
          "minimum": 1,
          "description": "Which thought index is being revised"
        },
        "branchFromThought": {
          "type": "integer",
          "minimum": 1,
          "description": "Thought index to branch from"
        },
        "branchId": {
          "type": "string",
          "description": "Identifier for this reasoning branch"
        },
        "hypothesis": {
          "type": "string",
          "description": "Explicit hypothesis being tested"
        },
        "sessionId": {
          "type": "string",
          "description": "Optional session ID"
        },
        "format": {
          "type": "string",
          "enum": [
            "markdown",
            "json"
          ],
          "default": "markdown"
        }
      },
      "required": [
        "thought",
        "thoughtNumber",
        "totalThoughts",
        "nextThoughtNeeded"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
