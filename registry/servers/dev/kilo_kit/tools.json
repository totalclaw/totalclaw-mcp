[
  {
    "name": "kilo_orchestrate_task",
    "description": "MANDATORY: Call this tool FIRST before diagnosing, debugging, analyzing, creating, or modifying any code, UI, backend, or project files. Determines task mode, selects required workflow skills, enforces brainstorming gating, and orchestrates the execution flow.",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "maxLength": 4000,
          "description": "Current user request or task summary."
        },
        "task": {
          "type": "string",
          "maxLength": 4000,
          "description": "Alias for message."
        },
        "prompt": {
          "type": "string",
          "maxLength": 4000,
          "description": "Alias for message."
        },
        "context": {
          "type": "object",
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 300
              },
              "maxItems": 30
            },
            "mode": {
              "type": "string",
              "maxLength": 80
            },
            "previousErrors": {
              "type": "string",
              "maxLength": 2000
            },
            "projectFingerprint": {
              "type": "string",
              "maxLength": 200
            }
          },
          "additionalProperties": false
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "brainstormingApproved": {
          "type": "boolean"
        },
        "answers": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "memoryConfirmations": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "accepted",
              "rejected"
            ]
          }
        },
        "format": {
          "type": "string",
          "enum": [
            "markdown",
            "json"
          ],
          "default": "markdown"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "kilo_memory_report",
    "description": "Read global C4 memory facts, decisions, and recent suggestions.",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "markdown",
            "json"
          ],
          "default": "markdown"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "kilo_record_reflection",
    "description": "Record correct approaches, wrong paths/pitfalls encountered, skill ratings, and lessons learned into SQLite to drive Kilo-Kit's continuous self-improvement across sessions.",
    "read_only": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "taskMode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Task mode (e.g. 'bug', 'architecture', 'ui', 'feature-build')."
        },
        "taskSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Summary of the problem solved."
        },
        "correctApproach": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "The successful strategy, fix, or architectural pattern used."
        },
        "wrongPathsEncountered": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "description": "Mistakes, wrong assumptions, or pitfalls encountered."
        },
        "skillsEvaluated": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "skillId": {
                "type": "string",
                "maxLength": 120
              },
              "score": {
                "type": "number",
                "minimum": 1,
                "maximum": 100
              },
              "feedback": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "skillId",
              "score"
            ],
            "additionalProperties": false
          },
          "description": "Ratings and feedback for specific skills used."
        },
        "lessonsLearned": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Key invariant or takeaway for future tasks."
        },
        "sessionId": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional session ID."
        },
        "format": {
          "type": "string",
          "enum": [
            "markdown",
            "json"
          ],
          "default": "markdown"
        }
      },
      "required": [
        "taskMode",
        "taskSummary",
        "correctApproach",
        "wrongPathsEncountered",
        "lessonsLearned"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "kilo_remember_fact",
    "description": "Explicitly persist a project operating rule, workflow default, or verification standard into SQLite memory_facts for cross-session enforcement.",
    "read_only": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "description": "Unique fact identifier, e.g. 'preference:testing:vitest' or 'rule:architecture:dexie'."
        },
        "kind": {
          "type": "string",
          "enum": [
            "verification-default",
            "workflow-default",
            "task-mode-default",
            "operating-rule"
          ],
          "description": "Fact classification kind."
        },
        "value": {
          "type": "object",
          "additionalProperties": {},
          "description": "Fact payload data, e.g. { commands: ['npm test'] } or { library: 'dexie' }."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence score between 0.0 and 1.0 (default 1.0)."
        },
        "source": {
          "type": "string",
          "description": "Source of fact (e.g. 'user-instruction', 'architecture-decision')."
        },
        "format": {
          "type": "string",
          "enum": [
            "markdown",
            "json"
          ],
          "default": "markdown"
        }
      },
      "required": [
        "key",
        "kind",
        "value"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "kilo_search_skills",
    "description": "Search the Kilo-Kit skill library by natural-language query. Use this for broad discovery before loading a specific skill.",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Natural-language task or keyword query."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Optional category such as engineering or design."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum number of skills to return."
        },
        "format": {
          "type": "string",
          "enum": [
            "markdown",
            "json"
          ],
          "default": "markdown"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "kilo_get_skill",
