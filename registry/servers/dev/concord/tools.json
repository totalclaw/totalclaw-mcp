[
  {
    "name": "start_work",
    "description": "Enter one task before editing: register or refresh this agent, accept addressed work when needed, claim the declared scope, and return actionable overlap warnings.",
    "read_only": false,
    "input_schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable task identifier, e.g. TASK-12"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Short human-readable title"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "Agent type or provider, e.g. claude-code or codex"
        },
        "agent_id": {
          "description": "Usually omit — Concord derives your identity from your session. Pass only the id your client told you (Codex); a session Concord can see always wins.",
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "description": "Human accountable for this agent and task"
        },
        "model": {
          "type": "string",
          "description": "Model the agent is running"
        },
        "summary": {
          "type": "string",
          "description": "One-line description of the current work"
        },
        "branch": {
          "type": "string",
          "description": "Git branch, if known"
        },
        "worktree": {
          "type": "string",
          "description": "Git worktree path, if used"
        },
        "cwd": {
          "type": "string",
          "description": "Agent working directory"
        },
        "pid": {
          "description": "Agent process id, if known",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "parent_task_id": {
          "type": "string",
          "description": "Parent task for a smaller claimed unit"
        },
        "expected_files": {
          "description": "Files expected to change",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modules": {
          "description": "Logical modules touched",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "domains": {
          "description": "Product domains touched",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk_tags": {
          "description": "Risk tags shared with related work",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string",
          "description": "Concise task notes"
        },
        "workspace_id": {
          "description": "Workspace id returned by a Concord operation. Omit to use the automatically resolved repository workspace.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task_id",
        "title",
        "kind"
      ]
    }
  },
  {
    "name": "inspect_work",
    "description": "Read the workspace, one task, one agent communication inbox/outbox, or one durable prompt/reply thread by supplying at most one selector. query searches past messages, findings, decisions and handoffs; search before asking a peer what was already found.",
    "read_only": true,
    "input_schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "task_id": {
          "description": "Task to inspect; omit for the whole workspace state",
          "type": "string",
          "minLength": 1
        },
        "agent_id": {
          "description": "Your own agent id to read your inbox/outbox with receipts (another agent shows presence only). With message_id or task_id, names you as the reader where Concord cannot see your session.",
          "type": "string",
          "minLength": 1
        },
        "message_id": {
          "description": "Prompt/reply thread to inspect",
          "type": "string",
          "minLength": 1
        },
        "query": {
          "description": "Search past messages you sent or received, and task findings, decisions and handoffs, for this text. Results name the task_id or message_id to open next.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "limit": {
          "description": "Most search results (default 20)",
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "include_superseded": {
          "description": "Include superseded decisions in task context (hidden by default)",
          "type": "boolean"
        },
        "workspace_id": {
          "description": "Workspace id returned by a Concord operation. Omit to use the automatically resolved repository workspace.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  {
    "name": "update_work",
    "description": "Record task context or deliver a live prompt/reply to another promptable workspace agent.",
    "read_only": false,
    "input_schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "operation": {
          "description": "Defaults to record; prompt and reply deliver live inter-agent messages",
          "type": "string",
          "enum": [
            "record",
            "prompt",
            "reply"
          ]
        },
        "task_id": {
          "description": "Required for record; optional context for prompts",
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "description": "Kind of task-scoped update",
          "type": "string",
          "enum": [
            "intent",
            "progress",
            "assumption",
            "decision",
            "question",
            "answer",
            "blocker",
            "finding"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "description": "Concise context another agent needs"
        },
        "supersedes": {
          "description": "For kind decision: id of an earlier decision on this task that this one replaces",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "supersede_reason": {
          "description": "Why the replaced decision no longer holds",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "agent_id": {
          "description": "Usually omit — Concord derives your identity from your session. Pass only the id your client told you (Codex); a session Concord can see always wins.",
          "type": "string",
          "minLength": 1
        },
        "to_agent_id": {
          "description": "Recipient required for prompt",
          "type": "string",
          "minLength": 1
        },
        "reply_to_message_id": {
          "description": "Message being answered for reply",
          "type": "string",
          "minLength": 1
        },
        "expects_reply": {
          "description": "For prompt/reply: whether you want an answer. Defaults to true for a prompt and false for a reply; set it on a reply only when you ask something back",
          "type": "boolean"
        },
        "idempotency_key": {
          "description": "Required for prompt and reply; makes delivery safe to retry",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "delivery_mode": {
          "description": "Live delivery mode; steer is the only mode in v1",
          "type": "string",
          "const": "steer"
        },
        "workspace_id": {
          "description": "Workspace id returned by a Concord operation. Omit to use the automatically resolved repository workspace.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "content"
      ]
    }
  },
  {
    "name": "transfer_work",
    "description": "Apply one versioned ownership action: assign, accept, decline, release, reassign, offer an evidence-bearing handoff, or reopen terminal work.",
    "read_only": false,
    "input_schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable task identifier, e.g. TASK-12"
        },
        "action": {
          "type": "string",
          "enum": [
            "assign",
            "accept",
            "decline",
            "release",
            "reassign",
            "offer",
            "reopen"
          ],
          "description": "Ownership action to apply through the versioned task state machine"
        },
        "agent_id": {
          "description": "Usually omit — Concord derives your identity from your session. Pass only the id your client told you (Codex); a session Concord can see always wins.",
          "type": "string",
          "minLength": 1
        },
        "expected_version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Task version last read by the caller; stale versions are rejected"
        },
        "to_agent_id": {
          "description": "Required for assign, reassign, and offer",
          "type": "string",
          "minLength": 1
        },
        "handoff_id": {
          "description": "Pending handoff to resolve; inferred from the task when omitted",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "lease_seconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "expires_seconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "force": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "what_changed": {
          "description": "Required for offer",
          "type": "string",
          "minLength": 1
        },
        "changed_files": {
          "description": "Files that changed",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tests_run": {
          "description": "Test commands run",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_risks": {
          "description": "Known risks introduced",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "description": "Assumptions made",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisions": {
          "description": "Notable decisions and why",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "guardrails_checked": {
          "description": "Guardrails checked",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_steps": {
          "description": "Remaining work or follow-ups",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workspace_id": {
          "description": "Workspace id returned by a Concord operation. Omit to use the automatically resolved repository workspace.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task_id",
        "action",
        "expected_version"
      ]
    }
  },
  {
    "name": "finish_work",
    "description": "Record completion evidence and atomically leave the task active as a handoff, mark it review-ready, or close it with a complete/closed outcome.",
    "read_only": false,
    "input_schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable task identifier, e.g. TASK-12"
        },
        "agent_id": {
          "description": "Usually omit — Concord derives your identity from your session. Pass only the id your client told you (Codex); a session Concord can see always wins.",
          "type": "string",
          "minLength": 1
        },
        "expected_version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Task version last read by the caller; stale versions are rejected"
        },
        "outcome": {
          "default": "complete",
          "description": "Final task state; handoff records evidence without changing lifecycle state",
          "type": "string",
          "enum": [
            "handoff",
            "review_ready",
            "complete",
            "closed"
          ]
        },
        "what_changed": {
          "type": "string",
          "minLength": 1,
          "description": "Concise summary of what changed"
        },
        "changed_files": {
          "description": "Files that changed",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tests_run": {
          "description": "Test commands run",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_risks": {
          "description": "Known risks introduced",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "description": "Assumptions made",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisions": {
          "description": "Notable decisions and why",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "guardrails_checked": {
          "description": "Guardrails checked",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_steps": {
          "description": "Remaining work or follow-ups",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "needs_review_from": {
          "description": "Who should review",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diff_size": {
          "description": "Rough diff size, e.g. +120 / -30",
          "type": "string"
        },
        "open_questions": {
          "description": "Unresolved review questions",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "description": "Evidence source for review claims, as { field, source } pairs. Whenever reported_outcome is supplied, include { field: \"reported_outcome\", source: \"<CI run, PR, or reviewer>\" } or one { field: \"reported_outcome.<key>\", source } per measured value",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "field",
              "source"
            ]
          }
        },
        "reported_outcome": {
          "description": "Optional measured acceptance, integration, or intervention result. Requires a provenance entry with field \"reported_outcome\" (or \"reported_outcome.acceptance\", \"reported_outcome.integration\", etc.) naming where the result came from",
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "agent",
                "ci",
                "review",
                "human"
              ]
            },
            "acceptance": {
              "default": "not_checked",
              "type": "string",
              "enum": [
                "accepted",
                "rejected",
                "not_checked"
              ]
            },
            "integration": {
              "default": "not_checked",
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "not_checked"
              ]
            },
            "human_intervention_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 604800000
            },
            "rework_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 604800000
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        "reason": {
          "description": "Audited terminal reason; defaults to the change summary",
          "type": "string",
          "minLength": 1
        },
        "workspace_id": {
          "description": "Workspace id returned by a Concord operation. Omit to use the automatically resolved repository workspace.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task_id",
        "expected_version",
        "what_changed"
      ]
    }
  }
]
