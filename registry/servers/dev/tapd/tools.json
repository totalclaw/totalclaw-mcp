[
  {
    "name": "list_stories",
    "description": "查询需求列表，按条件批量检索。返回的每项形如 {\"Story\": {...}}。 默认每页 30 条，最多 200。",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "integer",
          "description": "项目 ID（TAPD 里的 workspace_id）"
        },
        "status": {
          "type": "string",
          "description": "需求状态，支持枚举查询"
        },
        "name": {
          "type": "string",
          "description": "需求标题，支持模糊匹配"
        },
        "owner": {
          "type": "string",
          "description": "处理人，支持模糊匹配"
        },
        "iteration_id": {
          "type": "string",
          "description": "迭代 ID"
        },
        "priority_label": {
          "type": "string",
          "description": "优先级"
        },
        "limit": {
          "type": "integer",
          "description": "每页条数，默认 30，最大 200"
        },
        "page": {
          "type": "integer",
          "description": "页码，从 1 开始"
        },
        "fields": {
          "type": "string",
          "description": "只取这些字段，英文逗号分隔"
        },
        "order": {
          "type": "string",
          "description": "排序规则，如 created desc"
        }
      },
      "required": [
        "workspace_id"
      ]
    }
  },
  {
    "name": "get_story",
    "description": "按需求 ID 查询单个需求的详情。",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "integer",
          "description": "项目 ID"
        },
        "story_id": {
          "type": "string",
          "description": "需求 ID"
        }
      },
      "required": [
        "workspace_id",
        "story_id"
      ]
    }
  },
  {
    "name": "count_stories",
    "description": "统计满足条件的需求数量，用于快速了解规模而不拉全量数据。",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "integer",
          "description": "项目 ID"
        },
        "status": {
          "type": "string",
          "description": "需求状态"
        },
        "owner": {
          "type": "string",
          "description": "处理人"
        },
        "iteration_id": {
          "type": "string",
          "description": "迭代 ID"
        }
      },
      "required": [
        "workspace_id"
      ]
    }
  },
  {
