  {
    "name": "create_story",
    "description": "在项目中创建一条需求。这会真实写入 TAPD。",
    "read_only": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "integer",
          "description": "项目 ID"
        },
        "name": {
          "type": "string",
          "description": "需求标题"
        },
        "description": {
          "type": "string",
          "description": "需求详情，支持 HTML"
        },
        "owner": {
          "type": "string",
          "description": "处理人（TAPD 用户名）"
        },
        "priority_label": {
          "type": "string",
          "description": "优先级"
        },
        "iteration_id": {
          "type": "string",
          "description": "归属迭代 ID"
        },
        "creator": {
          "type": "string",
          "description": "创建人（TAPD 用户名）"
        }
      },
      "required": [
        "workspace_id",
        "name"
      ]
    }
  },
  {
    "name": "create_bug",
    "description": "在项目中提交一个缺陷。这会真实写入 TAPD。",
    "read_only": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "integer",
          "description": "项目 ID"
        },
        "title": {
          "type": "string",
          "description": "缺陷标题"
        },
        "description": {
          "type": "string",
          "description": "缺陷详情，支持 HTML"
        },
        "current_owner": {
          "type": "string",
          "description": "当前处理人（TAPD 用户名）"
        },
        "severity": {
          "type": "string",
          "description": "严重程度，如 fatal / serious / normal / prompt"
        },
        "priority_label": {
          "type": "string",
          "description": "优先级"
        },
        "reporter": {
          "type": "string",
          "description": "报告人（TAPD 用户名）"
        }
      },
      "required": [
        "workspace_id",
        "title"
      ]
    }
  }
]
