  {
    "name": "list_iterations",
    "description": "查询迭代列表，用于了解项目的迭代规划与起止时间。",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "integer",
          "description": "项目 ID"
        },
        "status": {
          "type": "string",
          "description": "迭代状态，如 open / done"
        },
        "limit": {
